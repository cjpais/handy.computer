---
export interface Props {
    name: string;
    href: string;
    imageSrc: string;
}

const { name, href, imageSrc } = Astro.props;
---

<a
    class="group flex w-16 shrink-0 flex-col items-center gap-1 transition-transform hover:scale-105 cursor-pointer"
    href={href}
    target="_blank"
>
    <img
        src={imageSrc}
        width="64"
        height="64"
        class="!rounded-full"
        alt={`${name} logo`}
    />
    <p
        class="!mb-0 whitespace-nowrap text-center text-sm text-handy-text opacity-100 transition-opacity group-hover:text-handy-pink sm:text-handy-pink md:opacity-0 md:group-hover:opacity-100"
    >
        {name}
    </p>
</a>
